{
  "name": "gatsby-source-ghost",
  "version": "5.0.3",
  "description": "Gatsby source plugin for building websites using the Ghost API as a data source.",
  "repository": "git@github.com:TryGhost/gatsby-source-ghost.git",
  "author": "Ghost Foundation",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "gatsby",
    "ghost",
    "gatsby-plugin",
    "gatsby-source-plugin"
  ],
  "engines": {
    "node": "18.x || 20.x"
  },
  "scripts": {
    "dev": "pnpm tsc src/*.ts --outDir . --ignoreConfig --watch",
    "build": "pnpm tsc src/*.ts --outDir . --ignoreConfig",
    "prepare": "cross-env NODE_ENV=production npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-ghost": "2.16.0",
    "mocha": "10.2.0",
    "proxyquire": "2.1.3",
    "should": "13.2.3",
    "sinon": "15.0.3",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@tryghost/content-api": "^1.12.13",
    "cheerio": "^1.2.0",
    "gatsby-node-helpers": "^1.2.1",
    "pkgroll": "^2.29.0",
    "qs": "6.11.1"
  }
}
